{
  "name": "ticky-crm",
  "version": "0.4.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build:code": "vite build",
    "build:translations": "node scripts/build-translations.js",
    "build": "npm run build:code && npm run build:translations",
    "lint": "eslint src/",
    "lint:fix": "eslint . --fix",
    "release": "node scripts/build-release.js",
    "release:publish": "node scripts/publish-release.js",
    "test:release": "node --test tests/release/*.test.js",
    "test": "npm run build && npm run lint && npm run test:phpstan && npm run test:integration",
    "test:integration": "./tests/integration/local_run_all.sh",
    "test:phpstan": "./vendor/phpstan/phpstan/phpstan"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/dialogs": "^7.6.0",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "^9.14.1",
    "@types/dompurify": "^3.2.0",
    "dompurify": "^3.4.17",
    "vue": "^3.5.44",
    "vue-material-design-icons": "^5.4.0"
  },
  "devDependencies": {
    "@nextcloud/vite-config": "^2.5.4",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "sass-embedded": "^1.107.1",
    "tar": "^7.5.22",
    "vite": "^7.3.7",
    "vue-eslint-parser": "^10.4.1"
  }
}
